# Copia este archivo a .env.production (o .env.development) y completa los valores reales.
# NUNCA subas el .env real a git — ya está en .gitignore.

PORT=4000
NODE_ENV=production

# URL pública del bot de WhatsApp/Telegram (proyecto-cuentas-bot-backend)
BOT_BASE_URL=https://backend-api.liordark.com

# Debe ser IDÉNTICA a DASHBOARD_API_KEY en el .env del bot — es la clave
# compartida para conectarse a GET /api/dashboard/stream
DASHBOARD_API_KEY=

# Contraseña para entrar al panel (un solo usuario/admin)
DASHBOARD_PASSWORD=

# Secreto para firmar la cookie de sesión — cualquier cadena larga y aleatoria
SESSION_SECRET=
